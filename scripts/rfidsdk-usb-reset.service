[Unit]
Description=DESATIVADO - Reset USB-serial RFIDSDK (afetava touch USB da tela)
# Este serviço NÃO deve estar habilitado.
# O reset USBDEVFS/unbind derrubava o touch da tela 7" (USB de comunicação).
# Se precisar do reset manual:  bash /home/pi/RFIDSDK/scripts/usb-serial-reset.sh
#
# Para garantir que está off no Pi:
#   sudo systemctl disable --now rfidsdk-usb-reset.service

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
